# This synthetic example intentionally matches the Windows log's BOM/CRLF
# bytes and final blank separator; do not normalize it on clone/check-out.
desktop-probe/examples/log-format-example.txt -text whitespace=cr-at-eol,-blank-at-eof

# Preserve console launchers' baseline bytes, including original CRLF endings.
console-probe/*.cmd -text whitespace=cr-at-eol
